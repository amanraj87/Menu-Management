# MongoDB connection string (create .env and set MONGO_URI)
# MONGO_URI=mongodb://localhost:27017/menu-management

# Optional: current user for dev (ObjectId from users collection). If set, X-User-Id header overrides.
# CURRENT_USER_ID=

# Firebase service-account JSON (single line/value) for sending FCM push notifications.
# Paste the ENTIRE contents of the downloaded service-account key file as the value.
# If unset, push notifications are silently disabled (the app still works).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"foodos-8b6d2",...}
